# === Python ignores ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.venv/
venv/
env/
.env
.pytest_cache/
.coverage
*.log

# === ROS ignores ===
devel/
install/
log/
*.bag
.catkin_workspace
.rosinstall

# === IDE & OS ===
.vscode/
.idea/
*.swp
.DS_Store

# === zed ros2 workspace ignores ===
zed-ros2-workspace/zed_wrapper/core*

# === Hailo binaries (proprietary, download from developer-zone) ===
*.deb
*.whl

# === Hailo HEF model files (auto-downloaded from S3 at runtime) ===
hailo_models/

# === Build/runtime caches ===
**/.cache/