# Ubuntu 24.04 (Noble) + ROS 2 Jazzy + OAK-D Pro W (DepthAI, no ZED/JetPack)
ARG IMAGE_NAME=ros:jazzy-ros-base-noble

FROM ${IMAGE_NAME}

# ROS 2 distribution
ARG ROS2_DIST=jazzy

# ROS2 dependencies version (Jazzy-compatible, non-ZED)
ARG ROBOT_LOCALIZATION_VERSION=3.9.4
ARG NMEA_MSGS_VERSION=2.1.0
ARG ANGLES_VERSION=1.16.0
ARG GEOGRAPHIC_INFO_VERSION=1.0.6
ARG RMW_CYCLONEDDS_VERSION=2.1.0

ENV DEBIAN_FRONTEND=noninteractive

# Disable apt-get warnings
RUN curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
   apt-get update || true && apt-get install -y --no-install-recommends apt-utils dialog && \
   rm -rf /var/lib/apt/lists/*

ENV TZ=Europe/Paris

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
  apt-get update && \
  apt-get install --yes lsb-release wget less udev sudo build-essential cmake python3 python3-dev python3-pip python3-wheel python3-serial \
  python-is-python3 git jq libpq-dev zstd usbutils python3-opencv && \
  rm -rf /var/lib/apt/lists/*

RUN apt-get update -y || true && \
  apt-get install -y --no-install-recommends zstd wget less cmake curl gnupg2 \
  build-essential python3 python3-pip python3-dev python3-setuptools libusb-1.0-0-dev \
  libgeographiclib-dev zlib1g-dev libboost-all-dev \
  ros-jazzy-diagnostic-updater \
  ros-jazzy-robot-localization -y

RUN pip install --break-system-packages protobuf

# Install the ROS2 Wrapper dependencies
ENV ROS_DISTRO=${ROS2_DIST}

# Copy the sources in the Docker image
WORKDIR /root/ros2_ws/src
COPY ros2_src/ ./

# Install ROS2 dependencies from source (non-ZED packages only)
WORKDIR /root/ros2_ws/src
RUN wget https://github.com/ros-drivers/nmea_msgs/archive/refs/tags/${NMEA_MSGS_VERSION}.tar.gz -O - | tar -xvz && mv nmea_msgs-${NMEA_MSGS_VERSION} nmea_msgs && \
    wget https://github.com/ros/angles/archive/refs/tags/${ANGLES_VERSION}.tar.gz -O - | tar -xvz && mv angles-${ANGLES_VERSION} angles && \
    wget https://github.com/ros2/rmw_cyclonedds/archive/refs/tags/${RMW_CYCLONEDDS_VERSION}.tar.gz -O - | tar -xvz && mv rmw_cyclonedds-${RMW_CYCLONEDDS_VERSION} rmw_cyclonedds && \
    wget https://github.com/ros-geographic-info/geographic_info/archive/refs/tags/${GEOGRAPHIC_INFO_VERSION}.tar.gz -O - | tar -xvz && mv geographic_info-${GEOGRAPHIC_INFO_VERSION} geographic-info && \
    cp -r geographic-info/geographic_msgs/ . && \
    rm -rf geographic-info

# Install cython, numpy, opencv
# PyQt5, sounddevice, pydub moved to demo-gui container.
# OAK-ROS2 only needs camera + shared memory + ROS 2.
RUN python3 -m pip install --break-system-packages --upgrade cython && \
    python3 -m pip install --break-system-packages --ignore-installed opencv-python-headless numpy==1.26.4 requests

# Build the ROS2 packages
WORKDIR /root/ros2_ws
RUN /bin/bash -c "source /opt/ros/$ROS_DISTRO/setup.bash && \
  colcon build --parallel-workers $(nproc) --symlink-install \
  --event-handlers console_direct+ --base-paths src \
  --packages-ignore zed_components zed_ros2 zed_wrapper \
  --cmake-args ' -DCMAKE_BUILD_TYPE=Release' \
  ' --no-warn-unused-cli' "

# Nav2 and HailoRT moved to dedicated containers (nav2/, hailo-inference/).
# OAK-ROS2 talks to Hailo via TCP client (hailo_inference_client.py, no HailoRT needed).
# Nav2 runs in its own container with CycloneDDS.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# OAK-D Pro W camera driver
RUN pip install --break-system-packages depthai requests

# DynamixelSDK, PyQt5, sounddevice, pydub → demo-gui container.

RUN mkdir -p /root/workspace
RUN git config --global --add safe.directory /root/workspace
WORKDIR /root/workspace

# Setup environment variables
COPY entrypoint.sh /sbin/entrypoint.sh
RUN sudo chmod 755 /sbin/entrypoint.sh

ENTRYPOINT ["/sbin/entrypoint.sh"]
CMD ["bash"]